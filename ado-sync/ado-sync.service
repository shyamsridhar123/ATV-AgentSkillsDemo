[Unit]
Description=ADO Sync — BacklogMD to Azure DevOps user story bridge
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/sschofield/repos/beth/ado-sync
EnvironmentFile=/home/sschofield/repos/beth/ado-sync/.env
ExecStart=/home/sschofield/repos/beth/ado-sync/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8321
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ado-sync

[Install]
WantedBy=multi-user.target
