# Azure DevOps Configuration
ADO_ORGANIZATION=your-org-name
ADO_PROJECT=your-project-name
ADO_PAT=your-personal-access-token
ADO_AREA_PATH=your-area-path              # e.g., "MyProject\\Team A"
ADO_ITERATION_PATH=your-iteration-path    # e.g., "MyProject\\Sprint 1"

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o            # or your deployment name
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21

# GitHub Webhook (for PR enrichment)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Backlog Watcher
BACKLOG_TASKS_DIR=./backlog/tasks          # Path to your BacklogMD tasks directory
BACKLOG_TASK_PREFIX=BETH                   # Task prefix (e.g., BETH-42)

# Optional
LOG_LEVEL=INFO
