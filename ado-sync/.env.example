# Azure DevOps Configuration
ADO_ORGANIZATION=your-org-name
ADO_PROJECT=your-project-name
ADO_TENANT_ID=                                        # Entra tenant ID (enables bearer auth; leave empty for PAT-only)
ADO_PAT=                                              # Personal Access Token (required if no tenant ID; also used as fallback)
ADO_AREA_PATH=                                         # e.g., "MyProject\\Team A"
ADO_ITERATION_PATH=                                    # e.g., "MyProject\\Sprint 1"

# Azure OpenAI Configuration
# Entra ID auth is used by default (via DefaultAzureCredential).
# Set AZURE_OPENAI_API_KEY only if your resource requires key-based auth.
# Set AZURE_OPENAI_TENANT_ID if the AOAI resource lives in a different tenant than your default.
# Leave endpoint empty to use the offline formatter.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TENANT_ID=

# GitHub Webhook (for PR enrichment)
GITHUB_WEBHOOK_SECRET=

# Backlog Watcher
BACKLOG_TASKS_DIR=./backlog/tasks
BACKLOG_TASK_PREFIX=BETH

# Optional
LOG_LEVEL=INFO
