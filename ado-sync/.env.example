# Azure DevOps Configuration
ADO_ORGANIZATION=your-org-name
ADO_PROJECT=your-project-name
ADO_TENANT_ID=                                        # Entra tenant ID (enables bearer auth; leave empty for PAT-only)
ADO_PAT=                                              # Personal Access Token (required if no tenant ID; also used as fallback)
ADO_AREA_PATH=                                         # e.g., "MyProject\\Team A"
ADO_ITERATION_PATH=                                    # e.g., "MyProject\\Sprint 1"

# --- Beth example ---
# ADO_ORGANIZATION=sschofield
# ADO_PROJECT=Beth
# ADO_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47

# Azure OpenAI Configuration (optional — offline formatter used when omitted)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# GitHub Webhook (for PR enrichment)
GITHUB_WEBHOOK_SECRET=

# Backlog Watcher
BACKLOG_TASKS_DIR=./backlog/tasks
BACKLOG_TASK_PREFIX=BETH

# Optional
LOG_LEVEL=INFO
