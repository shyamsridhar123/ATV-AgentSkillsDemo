# Azure DevOps Configuration
ADO_ORGANIZATION=sschofield
ADO_PROJECT=Beth
ADO_TENANT_ID=72f988bf-86f1-41af-91ab-2d7cd011db47  # Entra tenant (enables bearer auth)
ADO_PAT=                                              # Optional: fallback if Entra auth unavailable
ADO_AREA_PATH=                                         # e.g., "Beth\\Team A"
ADO_ITERATION_PATH=                                    # e.g., "Beth\\Sprint 1"

# Azure OpenAI Configuration (optional — offline formatter used when omitted)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# GitHub Webhook (for PR enrichment)
GITHUB_WEBHOOK_SECRET=

# Backlog Watcher
BACKLOG_TASKS_DIR=./backlog/tasks
BACKLOG_TASK_PREFIX=BETH

# Optional
LOG_LEVEL=INFO
