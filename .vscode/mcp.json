{
	"$schema": "https://code.visualstudio.com/docs/copilot/chat/mcp-servers",
	"servers": {
		"shadcn": {
			"command": "npx",
			"args": ["shadcn@3.7.0", "mcp"]
		},
		"playwright": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"]
		},
		"deepwiki": {
			"type": "http",
			"url": "https://mcp.deepwiki.com/mcp"
		},
		"backlog": {
			"command": "backlog",
			"args": ["mcp", "start"]
		}
	}
}