{
  "name": "beth-copilot",
  "version": "1.0.15",
  "description": "Beth - A ruthless, hyper-competent AI orchestrator for GitHub Copilot multi-agent workflows",
  "keywords": [
    "github-copilot",
    "ai-agents",
    "copilot-chat",
    "multi-agent",
    "orchestrator",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "Steph Schofield",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephschofield/beth.git"
  },
  "homepage": "https://github.com/stephschofield/beth#readme",
  "bugs": {
    "url": "https://github.com/stephschofield/beth/issues"
  },
  "bin": {
    "beth": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "assets/",
    "sbom.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'src/**/*.e2e.test.ts'",
    "test:e2e": "vitest run --include 'src/**/*.e2e.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node --test bin/lib/*.test.js",
    "test:legacy:ts": "npm run build && node --test dist/lib/*.test.js dist/cli/commands/*.test.js dist/core/agents/*.test.js dist/core/skills/*.test.js",
    "test:all": "npm run test && npm run test:legacy",
    "test:gate": "node scripts/quality-gate.mjs",
    "sbom:generate": "npx @cyclonedx/cyclonedx-npm --output-file sbom.json --output-format JSON",
    "prepublishOnly": "npm run build && npm run sbom:generate"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.9.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "bs-buster": "^0.1.8",
    "gray-matter": "^4.0.3"
  }
}
