# Beth Swarm Configuration — Example
# Copy to swarm.yaml and configure before running.
#
# SETUP (you need your own Azure OpenAI resource):
#   1. Create an Azure OpenAI resource: az cognitiveservices account create ...
#   2. Deploy a model (e.g. gpt-4o): az cognitiveservices account deployment create ...
#   3. Assign yourself the RBAC role:
#      az role assignment create --assignee <your-user-or-sp> \
#        --role "Cognitive Services OpenAI User" \
#        --scope /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>
#   4. Copy this file: cp swarm.yaml.example swarm.yaml
#   5. Replace "your-resource" with your Azure OpenAI resource name
#   6. Update deployment names under model_routing to match your deployments
#
# Auth mode: "identity" (RECOMMENDED) or "key"
#
# identity mode (no secrets needed):
#   Uses DefaultAzureCredential — picks up az login, managed identity, or env vars.
#   Requires: Cognitive Services OpenAI User role on the AOAI resource.
#   No env vars needed for auth.
#
# key mode (legacy):
#   Requires: AZURE_OPENAI_API_KEY env var
#   Store the key in Azure Key Vault, not in files.

db_path: swarm.db
poll_interval_seconds: 2.0
heartbeat_interval_seconds: 30.0

# Budget guardrails
max_task_tokens_in: 50000
max_task_tokens_out: 10000
max_epic_spend_usd: 5.0
max_daily_spend_usd: 50.0

test_command: "npm test"

# Primary: Azure OpenAI with managed identity (RECOMMENDED)
primary_provider:
  name: azure
  endpoint: https://your-resource.openai.azure.com/
  auth_mode: identity  # Uses DefaultAzureCredential — no API key needed
  api_version: "2024-12-01-preview"

# Alternative: Azure OpenAI with API key (NOT recommended)
# primary_provider:
#   name: azure
#   endpoint: https://your-resource.openai.azure.com/
#   auth_mode: key
#   api_key: ${AZURE_OPENAI_API_KEY}  # Store in Key Vault, reference via env var
#   api_version: "2024-12-01-preview"

# Fallback: OpenAI direct (optional — remove if not needed)
# fallback_provider:
#   name: openai
#   api_key: ${OPENAI_API_KEY}

# 3-tier model routing
model_routing:
  complex:
    deployment: gpt-5.4
    max_tokens: 16384
  standard:
    deployment: gpt-5.2
    max_tokens: 8192
  simple:
    deployment: gpt-5-mini
    max_tokens: 4096
